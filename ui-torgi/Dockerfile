# ==========================================
# ЭТАП 1: Сборщик (Builder)
# ==========================================
FROM node:22-alpine AS builder

# Создаём и переходим в папку /app внутри контейнера
WORKDIR /app

# 1. Сначала копируем ТОЛЬКО файлы со списком библиотек
COPY package.json package-lock.json ./

# 2. Устанавливаем все библиотеки (этот слой закэшируется!)
RUN npm ci

# 3. Копируем весь остальной код твоего магазина
COPY . .

# 4. Собираем проект (адаптер создаст папку /app/build)
RUN npm run build

# 5. Удаляем библиотеки для разработки (Vite, Svelte-компилятор и т.д.),
# оставляя только те, что нужны для работы самого сервера
RUN npm prune --production


# ==========================================
# ЭТАП 2: Чистый сервер для запуска (Runner)
# ==========================================
FROM node:22-alpine

WORKDIR /app

# Забираем из первого этапа ТОЛЬКО готовую папку build и нужные библиотеки
COPY --from=builder /app/build ./build
COPY --from=builder /app/node_modules ./node_modules
COPY package.json ./

# По умолчанию adapter-node запускает сервер на порту 3000
EXPOSE 3000
ENV NODE_ENV=production

# Команда, которая запускает наш магазин при старте контейнера
CMD ["node", "build"]